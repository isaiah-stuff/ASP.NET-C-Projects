@page
@model SportsPlay.Pages.Products.ModifyProductModel
@{
    ViewData["Title"] = "ACRP";
}

<h1>Modify Product</h1>

<label>Message:</label>
<label style="color: @Model.MessageColor">@Model.Message</label>

<form method="post">

    <input asp-for="Product.ProductID" type="hidden" />

    <table>
        <tr>
            <td><label asp-for="Product.CategoryID"></label></td>
            <td><select asp-for="Product.CategoryID" asp-items="@Model.CategorySelectList"></select></td>
        </tr>
        <tr>
            <td><label asp-for="Product.SupplierID"></label></td>
            <td><select asp-for="Product.SupplierID" asp-items="@Model.SupplierSelectList"></select></td>
        </tr>
        <tr>
            <td><label asp-for="Product.Product1"></label></td>
            <td><input asp-for="Product.Product1" /></td>
        </tr>
        <tr>
            <td><label asp-for="Product.Description"></label></td>
            <td><input asp-for="Product.Description" /></td>
        </tr>
        <tr>
            <td><label asp-for="Product.Image"></label></td>
            <td><input asp-for="Product.Image" /></td>
        </tr>
        <tr>
            <td><label asp-for="Product.Price"></label></td>
            <td><input asp-for="Product.Price" /></td>
        </tr>
        <tr>
            <td><label asp-for="Product.NumberInStock"></label></td>
            <td><input asp-for="Product.NumberInStock" /></td>
        </tr>
        <tr>
            <td><label asp-for="Product.NumberOnOrder"></label></td>
            <td><input asp-for="Product.NumberOnOrder" /></td>
        </tr>
        <tr>
            <td><label asp-for="Product.ReorderLevel"></label></td>
            <td><input asp-for="Product.ReorderLevel" /></td>
        </tr>
        <tr>
            <td></td>
            <td>
                <input asp-page-handler="Modify" type="submit" value="Modify" />
                <a asp-page="CancelProduct">Cancel</a>
            </td>
        </tr>
    </table>

</form>
