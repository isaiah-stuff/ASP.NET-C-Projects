@page "/"
@model Stuffle.Isaiah.Exam3.Pages.Categories.MaintainCategoriesModel
@{
    ViewData["Title"] = "Maintain Categories";
}

<h1>Maintain Categories</h1>

<label>Message:</label>
<label style="color: @Model.MessageColor">@Model.Message</label>
<br />

<table class="table">
    <thead>
        <tr>
            @*anchor element*@
            @*directs to addCategory page not redirect*@
            <td><a asp-page="AddCategory">Add</a></td>
            <th><label>Category</label></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ResultIList)
        {
            <tr>
                <td>
                    @*asp-route-intCategoryID tells it to pass the CategoryID to the Modify Page
                Need to know what Category to modify/delete
                *@
                    <a asp-page="ModifyCategory" asp-route-intCategoryID="@item.CategoryID">Modify</a>
                    <a asp-page="DeleteCategory" asp-route-intCategoryID="@item.CategoryID" onclick="return confirm('Are you sure you want to delete this item? Click OK to delete it. Click Cancel to keep it.')">Delete</a>
                </td>
                <td><label>@item.Category</label></td>
            </tr>
        }
    </tbody>
</table>