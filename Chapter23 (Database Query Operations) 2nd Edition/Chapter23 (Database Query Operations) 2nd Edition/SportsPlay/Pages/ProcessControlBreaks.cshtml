@page "/"
@model SportsPlay.Pages.ProcessControlBreaksModel
@{
    ViewData["Title"] = "ACRP";
}

<h1>Display Products</h1>

<table class="table">
    <thead>
        <tr>
            <th><label>Category</label></th>
            <th><label>Supplier</label></th>
            <th><label>Product</label></th>
            <th><label>Image</label></th>
            <th><label>Price</label></th>
        </tr>
    </thead>
    <tbody>
        @{ // Declare the control break variables.
            string strCategoryOld = "";
            string strCategoryNew = "";
        }
        @foreach (var item in Model.ResultIList)
        {
            strCategoryNew = item.Category;
            <tr>
                @if (strCategoryNew != strCategoryOld)
                {
                    <td><label>@item.Category</label></td>
                }
                else
                {
                    <td>&nbsp;</td> //no breaking space point
                }
                <td><label>@item.Supplier</label></td>
                <td><label>@item.Product</label></td>
                <td><label>@item.Image</label></td>
                <td><label>@item.Price</label></td>
            </tr>
            strCategoryOld = item.Category;
        }
    </tbody>
</table>
