@page "/"
@model Stuffle.Isaiah.Chapter23.Pages.FilterSuppliersWith_SelectModel
@{
    ViewData["Title"] = "Display Suppliers";
}

<h1>Display Suppliers</h1>

<style>

</style>


<form method="post">
    <filter>
        <input asp-page-handler="Filter" type="submit" value="Filter" />
    </filter>
    <select asp-for="CategoryID" asp-items="@Model.SupplierSelectList">
        <option value="0">- Category -</option>
    </select>

</form>

<table class="table">
    <thead>
        <tr>
            <th><label>Supplier</label></th>
            <th><label>Product</label></th>
            <th><label>Price</label></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ResultIList)
        {
            <tr>
                <td><label>@item.Supplier</label></td>
                <td><label>@item.Product</label></td>
                <td><label>@item.Price</label></td>
            </tr>
        }
    </tbody>
</table>
