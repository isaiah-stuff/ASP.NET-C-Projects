@page
@model Stuffle.Isaiah.Chapter17.Pages.Home.Log_InModel
@{
    ViewData["Title"] = "ACRP";
}
<form method="post">

    <table>
        <tr>
            <td><label>Email Address</label></td>
            <td><input asp-for="EmailAddress" /></td>
        </tr>
        <tr>
            <td><label>Password</label></td>
            <td><input asp-for="Password" type="password" /></td>
        </tr>
        <tr>
            <td></td>
            <td><input asp-page-handler="LogIn" type="submit" value="Log In" /></td>
        </tr>
    </table>

</form>
