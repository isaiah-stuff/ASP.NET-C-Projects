@page 
@model Stuffle.Isaiah.Chapter18.Pages.AddEmployeeBootrappedModel
@{
    ViewData["Title"] = "Add Employee";
}

<h1>Add Employee</h1>

<label class="fw-bold">Message:</label>

<form method="post">

    <div>
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-2">
                <lable class="fw-bold">Last Name</lable>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-2">
               <input class="form-check-control" />
            </div>
            <div class="row">
                <div class="col-sm-12 col-md-3 col-lg-2">
                    <label class="fw-bold">First Name</label>
                </div>
                <div class="col-sm-12 col-md-4 col-lg-3">
                    <input class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 col-md-3 col-lg-2">
                    <label class="fw-bold">Middle Initial</label>
                </div>
                <div class="col-sm-12 col-md-4 col-lg-3">
                    <input class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 col-md-3 col-lg-2">
                    <label class="fw-bold">Address</label>
                </div>
                <div class="col-sm-12 col-md-4 col-lg-3">
                    <input class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 col-md-3 col-lg-2">
                    <label class="fw-bold">City</label>
                </div>
                <div class="col-sm-12 col-md-4 col-lg-3">
                    <input class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 col-md-3 col-lg-2">
                    <label class="fw-bold">State</label>
                </div>
                <div class="col-sm-12 col-md-4 col-lg-3">
                    <select class="form-select w-50">
                        <option value=""></option>
                        <option value="IL">Illinois</option>
                        <option value="IN">Indiana</option>
                        <option value="IA">Iowa</option>
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 col-md-3 col-lg-2">
                    <label class="fw-bold">Zip Code</label>
                </div>
                <div class="col-sm-12 col-md-4 col-lg-3">
                    <input class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 col-md-3 col-lg-2">
                    <label class="fw-bold">Phone</label>
                </div>
                <div class="col-sm-12 col-md-4 col-lg-3">
                    <input class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 col-md-3 col-lg-2">
                    <label class="fw-bold">Email Address</label>
                </div>
                <div class="col-sm-12 col-md-4 col-lg-3">
                    <input class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 col-md-3 col-lg-2">
                    <label class="fw-bold">Password</label>
                </div>
                <div class="col-sm-12 col-md-4 col-lg-3">
                    <input class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 col-md-3 col-lg-2">
                    <label class="fw-bold">Status</label>
                </div>
                <div class="col-sm-12 col-md-4 col-lg-3">
                    <select class="form-select w-50">
                        <option value=""></option>
                        <option value="M">Manager</option>
                        <option value="S">Staff</option>
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 col-md-3 col-lg-2"></div>
                <div class="col-sm-12 col-md-4 col-lg-3">
                    <input class="btn btn-primary" type="submit" value="Add" />
                    <input class="btn btn-secondary" type="submit" value="Cancel" />
                </div>
            </div>
        </div>
    </div>
</form>
