@page "/"
@model Stuffle.Isaiah.Chapter18.Pages.AddProductModel
@{
    ViewData["Title"] = "ACRP";
}
<h1>Add Product</h1>

<label class=>Message:</label>

@*look at inputs make look pretty*@

<form method="post">
    <div>
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-2">
                <lable class="fw-bold">CategoryID</lable>
            </div>
            <div class="col-sm-12 col-md-3 col-lg=2">
                <input class="form-control" />
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-2">
                <lable class="fw-bold">SupplierID</lable>
            </div>
            <div class="col-sm-12 col-md-3 col-lg=2">
                <input class="form-control" />
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-2">
                <lable class="fw-bold">Product</lable>
            </div>
            <div class="col-sm-12 col-md-3 col-lg=2">
                <input class="form-control" />
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-2">
                <lable class="fw-bold">Description</lable>
            </div>
            <div class="col-sm-12 col-md-3 col-lg=2">
                <input class="form-control" />
            </div>
        </div><div class="row">
            <div class="col-sm-12 col-md-3 col-lg-2">
                <lable class="fw-bold">Image</lable>
            </div>
            <div class="col-sm-12 col-md-3 col-lg=2">
                <input class="form-control" />
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-2">
                <lable class="fw-bold">Price</lable>
            </div>
            <div class="col-sm-12 col-md-3 col-lg=2">
                <input class="form-control" />
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-2">
                <lable class="fw-bold">Number In Stock</lable>
            </div>
            <div class="col-sm-12 col-md-3 col-lg=2">
                <input class="form-control" />
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-2">
                <lable class="fw-bold">Number On Order</lable>
            </div>
            <div class="col-sm-12 col-md-3 col-lg=2">
                <input class="form-control" />
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-2">
                <lable class="fw-bold">Reorder Level</lable>
            </div>
            <div class="col-sm-12 col-md-3 col-lg=2">
                <input class="form-control" />
            </div>
            <div class="row">
                <div class="col-sm-12 col-md-3 col-lg-2">
                    <input class="btn btn-primary" type="submit" value="Add" />
                </div>
            </div>
        </div>
    </div>
</form>
