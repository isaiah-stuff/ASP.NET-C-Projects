<h1>Chat with Customer Service (24/7)</h1>

<label>Message:</label>
<label style="color: @Model.MessageColor">@Model.Message</label>

<form method="post">

    <label>Question</label><br />
    <input asp-for="Question" id="txtQuestion" size="97" /><br />
    <input asp-page-handler="Ask" onclick="return CheckForQuestion();"
           type="submit" value="Ask" />

</form>
<br />

<label>Answer</label>
<br />
<textarea cols="100" readonly rows="10">@Model.Answer</textarea>
